# Python bytecode caches, generated automatically on every import.
__pycache__/
*.pyc

# Tool caches generated by running mypy/pytest locally or in CI.
.mypy_cache/
.pytest_cache/

# setuptools/pip build output (this project defines [build-system] in
# pyproject.toml, so `pip install -e .` / `python -m build` can produce
# these).
*.egg-info/
build/
dist/

# Local virtual environments.
.venv/
venv/

# Local secrets/environment overrides. No .env file exists in this repo
# today; this guards against ever accidentally committing one.
.env

# Privileged research artifacts (MEGB-03B policy, extended to all later
# MEGB-03 subtasks producing oracle/reference data): full manifests and
# oracle bytes stay out of git entirely. Their identity is anchored by a
# committed *.lock.json (checksums, sizes, generation provenance) instead;
# see docs/measurement/privileged-artifact-policy.md. Regenerate via each
# module's `build`/`verify` CLI mode rather than trusting a copy on disk.
artifacts/privileged/

# MEGB-03G.4 benchmark run outputs (safe, non-privileged audit log + JSON
# report) -- generated, reproducible local run artifacts, not source; see
# tickets/megb-03.md's checkpoint log for the recorded measured results.
artifacts/reference/g4_benchmark_audit/
