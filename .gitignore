# Python bytecode caches, generated automatically on every import.
__pycache__/
*.pyc

# Tool caches generated by running mypy/pytest locally or in CI.
.mypy_cache/
.pytest_cache/

# setuptools/pip build output (this project defines [build-system] in
# pyproject.toml, so `pip install -e .` / `python -m build` can produce
# these).
*.egg-info/
build/
dist/

# Local virtual environments.
.venv/
venv/

# Local secrets/environment overrides. No .env file exists in this repo
# today; this guards against ever accidentally committing one.
.env
